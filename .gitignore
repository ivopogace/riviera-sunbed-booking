# IDE
.idea/
*.iml
.vscode/

# OS
Thumbs.db
.DS_Store

# Build output (added as the stack is scaffolded)
/platform/build/
/platform/.gradle/
/frontend/dist/
node_modules/
# The guard suites' coverage report, written by the `sonar` job (and by the same command run locally)
/scripts/coverage/

# Playwright MCP server scratch output (snapshots, traces) — written to wherever it is spawned
.playwright-mcp/

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log

# Local env / secrets — never commit Stripe keys, DB creds, etc.
*.env
.env.*
!.env.example

# Claude Code personal/local settings (not team-wide)
.claude/settings.local.json

# Claude Code isolated-worktree agent scratch space (not team-wide)
.claude/worktrees/
