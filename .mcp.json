{
  "mcpServers": {
    "angular-cli": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/scripts/angular-cli-mcp.mjs"
      ]
    },
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLAUDE_RENDER_KEY}"
      }
    },
    "playwright": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/scripts/playwright-mcp.mjs"
      ]
    },
    "idea": {
      "url": "http://127.0.0.1:64360/stream",
      "type": "http"
    }
  }
}